{
  "lexicon": 1,
  "id": "blue.catbird.onboarding.getCalibrationSwipes",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Build dynamic contrastive Taste Duel cards tailored to the user's selected communities and potential ambiguity traps.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["selections"],
          "properties": {
            "selections": {
              "type": "array",
              "maxLength": 24,
              "items": {
                "type": "ref",
                "ref": "blue.catbird.onboarding.defs#communitySelection"
              }
            },
            "seedFollowDids": {
              "type": "array",
              "maxLength": 100,
              "items": { "type": "string", "format": "did" }
            },
            "maxSwipes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "default": 5
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["catalogVersion", "swipes"],
          "properties": {
            "catalogVersion": { "type": "string" },
            "swipes": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "blue.catbird.onboarding.defs#calibrationSwipeCard"
              }
            }
          }
        }
      },
      "errors": [
        { "name": "AuthRequired" },
        { "name": "InvalidRequest" },
        { "name": "UpstreamUnavailable" }
      ]
    }
  }
}

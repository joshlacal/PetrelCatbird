{
  "lexicon": 1,
  "id": "blue.catbird.chat.acknowledgeEntries",
  "description": "Post-commit acknowledgment of delivered entries up to upToSeq by an active leaf device. Once all active non-dormant leaf devices acknowledge an applicationMessageEntry, mls-ds prunes accepted_payload_bytes to NULL while preserving seq contiguity and all MLS control entries.",
  "defs": {
    "main": {
      "type": "procedure",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "conversationId",
            "generation",
            "actorDeviceId",
            "upToSeq"
          ],
          "properties": {
            "conversationId": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#operationId"
            },
            "generation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "actorDeviceId": {
              "type": "ref",
              "ref": "blue.catbird.chat.defs#deviceId"
            },
            "upToSeq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "acknowledgedSeq",
            "prunedCount"
          ],
          "properties": {
            "acknowledgedSeq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "prunedCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "errors": [
        {
          "name": "ConversationNotFound"
        },
        {
          "name": "DeviceNotLeaf"
        },
        {
          "name": "DeviceNotRegistered"
        },
        {
          "name": "DeviceRevoked"
        },
        {
          "name": "InvalidRequest"
        },
        {
          "name": "NotAuthorized"
        }
      ]
    }
  }
}

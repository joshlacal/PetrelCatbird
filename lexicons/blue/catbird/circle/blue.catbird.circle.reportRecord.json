{
  "lexicon": 1,
  "id": "blue.catbird.circle.reportRecord",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Report a record in a Circle Space",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["space", "uri", "reason"],
          "properties": {
            "space": { "type": "string", "format": "space-ref" },
            "uri": { "type": "string", "format": "at-uri" },
            "reason": { "type": "string", "enum": ["spam", "abuse", "other"] },
            "details": { "type": "string", "maxLength": 500 },
            "disclosedPostKey": { "type": "bytes", "minLength": 32, "maxLength": 32, "description": "Per-post key voluntarily disclosed by the reporter so moderators can read an encrypted post." },
            "disclosedMedia": {
              "type": "array",
              "maxLength": 32,
              "items": { "type": "ref", "ref": "#disclosedMedia" },
              "description": "Decryption material for attachments the reporter chooses to disclose."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 36, "maxLength": 36, "description": "Canonical lowercase hyphenated RFC 4122 UUID." }
          }
        }
      },
      "errors": [
        { "name": "AuthRequired" },
        { "name": "AccessRemoved" },
        { "name": "UnsupportedPDS" },
        { "name": "ProtocolRevisionMismatch" },
        { "name": "UpstreamUnavailable" }
      ]
    },
    "disclosedMedia": {
      "type": "object",
      "required": ["cid", "key", "iv"],
      "properties": {
        "cid": { "type": "string", "maxLength": 128 },
        "key": { "type": "bytes", "maxLength": 64 },
        "iv": { "type": "bytes", "maxLength": 32 }
      }
    }
  }
}

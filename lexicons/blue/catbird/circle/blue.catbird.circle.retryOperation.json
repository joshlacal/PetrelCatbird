{
  "lexicon": 1,
  "id": "blue.catbird.circle.retryOperation",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Retry an existing Circle operation",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "description": "Canonical lowercase hyphenated RFC 4122 UUID."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "blue.catbird.circle.defs#operation"
        }
      },
      "errors": [
        { "name": "AuthRequired" },
        { "name": "AccessRemoved" },
        { "name": "UnsupportedPDS" },
        { "name": "ProtocolRevisionMismatch" },
        { "name": "UpstreamUnavailable" }
      ]
    }
  }
}

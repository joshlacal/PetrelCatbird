{
  "lexicon": 1,
  "id": "blue.catbird.circle.createCircle",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Create a new Circle Space",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["name", "memberDids"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 64 },
            "memberDids": {
              "type": "array",
              "maxLength": 150,
              "items": { "type": "string", "format": "did" }
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "ref",
          "ref": "blue.catbird.circle.defs#operation"
        }
      },
      "errors": [
        { "name": "AuthRequired" },
        { "name": "AccessRemoved" },
        { "name": "UnsupportedPDS" },
        { "name": "ProtocolRevisionMismatch" },
        { "name": "UpstreamUnavailable" }
      ]
    }
  }
}

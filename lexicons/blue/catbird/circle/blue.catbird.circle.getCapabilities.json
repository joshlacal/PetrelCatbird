{
  "lexicon": 1,
  "id": "blue.catbird.circle.getCapabilities",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get capability metadata for Catbird Circles support",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["enabled", "protocolRevision", "supportsImages"],
          "properties": {
            "enabled": { "type": "boolean" },
            "protocolRevision": { "type": "string" },
            "supportsImages": { "type": "boolean" }
          }
        }
      },
      "errors": [
        { "name": "AuthRequired" },
        { "name": "AccessRemoved" },
        { "name": "UnsupportedPDS" },
        { "name": "ProtocolRevisionMismatch" },
        { "name": "UpstreamUnavailable" }
      ]
    }
  }
}
